{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "./dist",

    // На этих двух держится DI: контейнер Nest читает типы конструктора
    // из метаданных, которые эмитит компилятор.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    // Карты нужны, чтобы стек-трейсы указывали на .ts; читает их Node,
    // запущенный с --enable-source-maps (см. CMD в Dockerfile).
    "sourceMap": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist"]
}

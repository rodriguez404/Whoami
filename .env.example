# Скопировать в .env и при необходимости поправить.
# Без .env стенд тоже поднимается: compose.yaml содержит те же значения по умолчанию.

NODE_ENV=development
APP_PORT=3000

# Единственное место, где заданы креденшелы. POSTGRES_DSN ниже собирается из них,
# поэтому менять пароль надо ровно в одной строке.
POSTGRES_USER=whoami
POSTGRES_PASSWORD=whoami
POSTGRES_DB=whoami
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Для запуска на хосте (npm run start:dev).
# Внутри compose переменная собирается заново — там хост другой (имя сервиса postgres, а не localhost).
POSTGRES_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public
